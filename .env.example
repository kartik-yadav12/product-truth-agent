# Required for Luna
CIS_LLM_ENDPOINT=https://llm-api-cis.azure-intlsd-np.nielsencsp.net/
CIS_LLM_API_KEY=Bearer <YOUR_API_KEY>
CIS_LLM_MODEL=hack-fest-gpt-5.6-luna

# Optional web search provider. If empty, direct web search fallback is used.
# TAVILY_API_KEY=

# Retrieval limits
MAX_SEARCH_RESULTS=6
MAX_PAGE_CHARS=18000
