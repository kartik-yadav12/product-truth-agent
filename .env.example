# Required for the Luna LLM. The "Bearer " prefix is optional.
CIS_LLM_ENDPOINT=https://llm-api-cis.azure-intlsd-np.nielsencsp.net/
CIS_LLM_API_KEY=
CIS_LLM_MODEL=hack-fest-gpt-5.6-luna
CIS_LLM_API_VERSION=2025-03-01-preview

# Optional licensed search provider. If empty, Bing is scraped with a
# DuckDuckGo fallback (prototype only).
TAVILY_API_KEY=

# Retrieval limits
MAX_SEARCH_RESULTS=6
MAX_PAGE_CHARS=18000
REQUEST_TIMEOUT=15

# Prompt size limits
MAX_EVIDENCE_ITEMS=4
MAX_EVIDENCE_CHARS=6000
